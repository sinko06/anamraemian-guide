:root{font-family:Pretendard,'Noto Sans KR',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#21313b;background:#f7f9f7;font-synthesis:none}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0}a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer}button:focus-visible,a:focus-visible{outline:3px solid #339975;outline-offset:3px}.shell{max-width:1140px;margin:auto;padding:0 34px}.topbar{background:#fff;border-bottom:1px solid #e7ece9;position:sticky;top:0;z-index:10}.top-inner{height:82px;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:13px}.brand-symbol{width:45px;height:45px;display:grid;place-items:center;background:#113b36;color:white;font-weight:800;font-size:27px;border-radius:13px;letter-spacing:-2px}.dot{color:#8dd2b4}.brand-copy{font-weight:850;font-size:20px;letter-spacing:-.7px;line-height:1.15}.brand-copy small{display:block;font-size:11px;letter-spacing:1px;font-weight:600;color:#84928d;margin-top:5px}.top-actions{display:flex;align-items:center;gap:20px}.public-pill{font-size:12px;color:#527266;background:#eff6f1;border:1px solid #dceadf;border-radius:30px;padding:9px 13px}.alive{display:inline-block;width:7px;height:7px;background:#38a57b;border-radius:50%;margin-right:6px}.home-link{font-size:14px;font-weight:700;color:#61736d}.hero{background:#112e38;color:#fff;position:relative;overflow:hidden}.hero:after{content:'';position:absolute;right:-110px;top:-200px;width:630px;height:630px;border:1px solid #ffffff1f;border-radius:50%;box-shadow:0 0 0 88px #ffffff06,0 0 0 180px #ffffff06;pointer-events:none}.hero-inner{padding-top:78px;padding-bottom:86px;position:relative;z-index:1}.eyebrow{color:#8edbb7;font-size:12px;letter-spacing:2px;font-weight:800}.hero h1{font-size:clamp(34px,5.5vw,59px);line-height:1.27;letter-spacing:-2.4px;margin:17px 0 19px;font-weight:850}.hero h1 em{font-style:normal;color:#94dec1}.hero p{font-size:16px;line-height:1.9;color:#bdced0;margin:0;max-width:560px}.hero-bottom{margin-top:30px;display:flex;align-items:center;gap:11px;font-size:12px;color:#abc2bf}.line{width:33px;height:1px;background:#8edbb7}.section{padding:66px 0 85px}.section-head{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:27px}.section-head .kicker{color:#309075;font-size:12px;font-weight:800;letter-spacing:1.7px}.section-head h2{font-size:30px;letter-spacing:-1.1px;margin:8px 0 8px}.section-head p{color:#7a8a86;margin:0;font-size:14px}.count{font-size:13px;color:#8a9994}.category-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.category-card{position:relative;border:1px solid #e1eae5;border-radius:19px;overflow:hidden;display:block;background:#fff;box-shadow:0 9px 25px #24362c08;transition:transform .2s,box-shadow .2s}.category-card:hover{transform:translateY(-4px);box-shadow:0 16px 35px #24362c17}.card-art{height:198px;position:relative;overflow:hidden;background-color:#d8e6e4}.card-art.sky{background:linear-gradient(140deg,#cce2e5,#819ca6)}.card-art.mint{background:linear-gradient(135deg,#bedfd5,#7cb3aa)}.card-art.sand{background:linear-gradient(135deg,#eee6d3,#b9ac92)}.card-art.leaf{background:linear-gradient(135deg,#dce8d5,#86ad8f)}.art-grid{position:absolute;inset:0;opacity:.29;background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);background-size:48px 48px;transform:perspective(400px) rotateX(30deg) scale(1.5)}.art-icon{position:absolute;right:27px;bottom:-39px;font-size:185px;line-height:1;font-weight:200;color:#ffffff80;text-shadow:0 7px 45px #16393225}.art-tag{position:absolute;left:24px;top:23px;background:#ffffffc9;color:#294a4a;padding:8px 11px;border-radius:30px;font-size:10px;letter-spacing:1px;font-weight:800}.card-art.has-img{background-size:cover;background-position:center}.card-art.has-img .art-icon,.card-art.has-img .art-grid{display:none}.card-body{padding:23px 24px 26px}.card-body h3{font-size:21px;letter-spacing:-.7px;margin:0 0 9px}.card-body p{font-size:13px;color:#7a8b85;line-height:1.8;min-height:45px;margin:0 0 19px}.card-foot{display:flex;justify-content:space-between;align-items:center;color:#288a6c;font-size:13px;font-weight:800}.arrow-round{border-radius:50%;width:32px;height:32px;background:#edf6f1;display:grid;place-items:center;font-size:20px}.info-banner{margin-top:26px;background:#eaf2ec;border-radius:14px;display:flex;gap:14px;align-items:center;padding:18px 21px;color:#476b5d;font-size:13px;line-height:1.6}.info-mark{font-size:23px}.footer{border-top:1px solid #e0e8e3;background:#fff}.footer-inner{padding-top:30px;padding-bottom:36px;display:flex;justify-content:space-between;gap:20px}.footer strong{font-size:16px}.footer p,.footer span{font-size:12px;color:#899792;line-height:1.7}.footer span{max-width:320px}.back-link{display:inline-flex;gap:7px;align-items:center;font-size:14px;color:#607b70;font-weight:700;margin-bottom:28px}.subhero{background:#112e38;color:#fff;padding:52px 0}.subhero .eyebrow{font-size:11px}.subhero h1{margin:10px 0;font-size:38px;letter-spacing:-1.5px}.subhero p{color:#bed0cf;line-height:1.75;margin:0}.posts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.post-card{display:block;border:1px solid #e0e8e3;background:#fff;border-radius:16px;padding:25px;transition:box-shadow .2s}.post-card:hover{box-shadow:0 12px 25px #1e3e3215}.post-card .meta,.date{font-size:12px;color:#86958e}.post-card h3{margin:10px 0;font-size:20px;letter-spacing:-.5px}.post-card p{color:#7a8982;line-height:1.75;font-size:14px}.post-bottom{margin-top:20px;color:#257d65;font-weight:800;font-size:13px}.article{background:#fff;border:1px solid #e2e9e5;padding:clamp(22px,4vw,44px);border-radius:20px}.article-title{font-size:clamp(27px,4vw,40px);line-height:1.3;letter-spacing:-1px;margin:13px 0 10px}.article-intro{font-size:16px;color:#6c7a74;line-height:1.85;margin:24px 0 32px}.notice{border-radius:12px;background:#f0f6f2;padding:17px 20px;color:#507665;line-height:1.8;font-size:14px}.gallery-head{margin:36px 0 16px;display:flex;justify-content:space-between;align-items:center}.gallery-head h3{margin:0}.tabs{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:18px}.tab{border:1px solid #dae6df;background:white;padding:9px 14px;border-radius:30px;color:#587265;font-size:13px}.tab.active{background:#194e40;color:white;border-color:#194e40}.gallery-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.photo{border:0;background:#f3f6f2;padding:0;border-radius:12px;overflow:hidden;text-align:left}.photo img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block}.photo strong,.photo small{display:block;padding:0 11px}.photo strong{font-size:12px;padding-top:9px}.photo small{font-size:11px;color:#7e9287;padding-bottom:12px;padding-top:3px}.empty{padding:40px 25px;text-align:center;border:1px dashed #d6e4dd;border-radius:14px;color:#81928a;background:#f8faf8;font-size:14px;line-height:1.9}.lightbox{position:fixed;inset:0;background:#061714ed;color:white;z-index:100;display:flex;align-items:center;justify-content:center;gap:12px;padding:30px}.lightbox[hidden]{display:none}.lightbox figure{margin:0;max-width:min(90vw,1050px);text-align:center}.lightbox img{max-width:100%;max-height:78vh;object-fit:contain}.lightbox figcaption{padding-top:12px;font-size:13px}.lightbox button{background:#ffffff30;border:0;border-radius:50%;color:#fff;width:43px;height:43px;font-size:29px;flex-shrink:0}.close-lightbox{position:absolute;top:17px;right:17px}.lightbox button:hover{background:#ffffff55}@media(max-width:700px){.shell{padding:0 18px}.top-inner{height:68px}.brand-symbol{width:38px;height:38px;font-size:23px}.brand-copy{font-size:17px}.brand-copy small{font-size:10px}.public-pill{display:none}.hero-inner{padding-top:61px;padding-bottom:65px}.hero h1{font-size:38px;letter-spacing:-1.6px}.hero p{font-size:14px}.section{padding:44px 0 60px}.section-head h2{font-size:25px}.section-head p{font-size:12px}.category-grid{gap:12px}.card-art{height:138px}.art-icon{font-size:130px;right:8px;bottom:-22px}.art-tag{left:12px;top:12px;font-size:8px;padding:6px 8px;letter-spacing:.3px}.card-body{padding:16px 13px 17px}.card-body h3{font-size:17px;margin-bottom:7px}.card-body p{font-size:11px;line-height:1.65;min-height:72px}.card-foot{font-size:11px}.arrow-round{height:26px;width:26px;font-size:16px}.info-banner{font-size:12px}.footer-inner{display:block}.subhero{padding:39px 0}.subhero h1{font-size:29px}.posts{grid-template-columns:1fr}.gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.article{padding:19px}.lightbox{gap:5px;padding:10px}.lightbox button{width:28px;height:34px;border-radius:8px;font-size:22px}.lightbox figure{max-width:calc(100vw - 76px)}}@media(max-width:360px){.card-body h3{font-size:15px}.card-body p{min-height:88px}.art-tag{font-size:7px}.category-grid{gap:9px}}
